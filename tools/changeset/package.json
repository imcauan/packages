    "@changesets/write": "1.0.1",
    "@clack/prompts": "1.8.1",
    "@manypkg/get-packages": "3.1.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@imcauan/typescript-config": "workspace:*",
    "@imcauan/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
