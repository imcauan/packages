{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["*.config.{ts,mjs}"]
    },
    "packages/*": {
      "entry": ["tests/**/*.{spec,test}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "*.config.ts"]
    },
    "packages/typescript-config": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["tests/**/*.ts", "*.config.ts"]
    },
    "packages/logger": {
      "entry": ["tests/**/*.{spec,test}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "*.config.ts"],
      "ignoreDependencies": ["pino-loki", "pino-pretty"]
    },
    "tools/changeset": {
      "entry": ["tests/**/*.{spec,test}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
    },
    "apps/docs": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "*.config.{ts,mjs}"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
