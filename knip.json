{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["*.config.{ts,mjs}"]
    },
    "packages/*": {
      "entry": ["tests/**/*.{spec,test}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "*.config.ts"]
    },
    "packages/typescript-config": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["tests/**/*.ts", "*.config.ts"]
    }
  }
}
