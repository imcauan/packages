{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["*.config.{ts,mjs}"]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/*/index.ts",
        "tests/**/*.{spec,test}.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "*.config.ts"]
    }
  }
}
