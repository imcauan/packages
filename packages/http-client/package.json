{
  "name": "@imcauan/http-client",
  "version": "0.0.0",
  "description": "HTTP client ports with normalized responses, retries and lifecycle hooks, and an adapter built on axios.",
  "homepage": "https://github.com/imcauan/packages/tree/main/packages/http-client#readme",
  "bugs": "https://github.com/imcauan/packages/issues",
  "license": "MIT",
  "author": "Cauan Diniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcauan/packages.git",
    "directory": "packages/http-client"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./axios": {
      "types": "./dist/axios/index.d.mts",
      "default": "./dist/axios/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@imcauan/typescript-config": "workspace:*",
    "@imcauan/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "axios": "1.20.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "axios": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
