{
  "name": "@imcauan/query-integration",
  "version": "0.0.0",
  "description": "Declares TanStack Query options on use-case classes with decorators, and runs them as queries and mutations with React hooks.",
  "homepage": "https://github.com/imcauan/packages/tree/main/packages/query-integration#readme",
  "bugs": "https://github.com/imcauan/packages/issues",
  "license": "MIT",
  "author": "Cauan Diniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcauan/packages.git",
    "directory": "packages/query-integration"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@imcauan/dependency-injection": "workspace:^"
  },
  "devDependencies": {
    "@imcauan/typescript-config": "workspace:*",
    "@imcauan/vitest-config": "workspace:*",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.2.0 || ^19.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
