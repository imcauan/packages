{
  "name": "@imcauan/logger",
  "version": "0.1.0",
  "description": "Structured logging with OpenTelemetry trace correlation, with a NestJS module built on nestjs-pino.",
  "homepage": "https://github.com/imcauan/packages/tree/main/packages/logger#readme",
  "bugs": "https://github.com/imcauan/packages/issues",
  "license": "MIT",
  "author": "Cauan Diniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcauan/packages.git",
    "directory": "packages/logger"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.mts",
      "default": "./dist/nestjs/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@imcauan/typescript-config": "workspace:*",
    "@imcauan/vitest-config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "catalog:",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-loki": "3.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "nestjs-pino": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-http": {
      "optional": true
    },
    "pino-loki": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
