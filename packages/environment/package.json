{
  "name": "@imcauan/environment",
  "version": "0.1.0",
  "description": "Typed, validated environment variables, with a NestJS module built on @nestjs/config.",
  "homepage": "https://github.com/imcauan/packages/tree/main/packages/environment#readme",
  "bugs": "https://github.com/imcauan/packages/issues",
  "license": "MIT",
  "author": "Cauan Diniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcauan/packages.git",
    "directory": "packages/environment"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.mts",
      "default": "./dist/nestjs/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@imcauan/validation": "workspace:^"
  },
  "devDependencies": {
    "@imcauan/typescript-config": "workspace:*",
    "@imcauan/vitest-config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
