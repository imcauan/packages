{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@imcauan/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node", "vitest/globals"],
    "paths": { "@/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out", ".next"]
}
